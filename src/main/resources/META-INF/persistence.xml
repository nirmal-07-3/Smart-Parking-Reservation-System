<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="SmartParkingPU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>


        <class>com.smartparking.entity.User</class>
        <class>com.smartparking.entity.Vehicle</class>
        <class>com.smartparking.entity.Reservation</class>
        <class>com.smartparking.entity.Payment</class>
        <class>com.smartparking.entity.ProviderApplication</class>
        <class>com.smartparking.entity.ParkingDocument</class>
        <class>com.smartparking.entity.ParkingLocation</class>
        <class>com.smartparking.entity.ParkingSlot</class>


        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/smart_parking?useSSL=false&amp;serverTimezone=Asia/Kolkata"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="Nirmal@2005"/>

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.MySQLDialect"/>

            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>